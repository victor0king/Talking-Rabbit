# ──────────────────────────────────────────────────
# Talking Rabbitt — Environment Configuration
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────────

# ── Database ─────────────────────────────────────
# If MySQL is unavailable, the app auto-falls back to SQLite
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=talking_rabbitt

# ── AI / LLM ────────────────────────────────────
# Required for the "Ask Rabbitt" chat feature
# If not set, chat shows a fallback message; all other features still work
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ── Server ───────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false

# ── Security ─────────────────────────────────────
# SECRET_KEY=your-secret-key-for-jwt
